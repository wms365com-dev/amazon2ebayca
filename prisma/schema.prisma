generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MatchMethod {
  UPC
  GTIN
  BRAND_MODEL
  TITLE_SIMILARITY
  MANUAL
}

enum OpportunityStatus {
  NEW
  WATCH
  BUY
  REJECT
  REVIEW
}

enum ScanJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ApiLogSource {
  EBAY
  AMAZON
  SCHEDULER
  APP
}

enum Marketplace {
  EBAY_CA
  AMAZON_CA
}

enum SavedSearchKind {
  MANUAL
  REPLEN_MONITOR
}

model User {
  id               Int               @id @default(autoincrement())
  email            String?           @unique
  name             String
  savedSearches    SavedSearch[]
  monitoredProducts MonitoredProduct[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SavedSearch {
  id                   Int           @id @default(autoincrement())
  userId               Int?
  name                 String
  kind                 SavedSearchKind @default(MANUAL)
  sourceMarketplace    Marketplace   @default(EBAY_CA)
  destinationMarketplace Marketplace @default(AMAZON_CA)
  keywords             String
  categoryId           String?
  includeBrands        Json?
  excludeBrands        Json?
  minPrice             Float?
  maxPrice             Float?
  conditionFilter      String?
  buyItNowOnly         Boolean       @default(true)
  allowAuctions        Boolean       @default(false)
  maxShipping          Float?
  minROI               Float?
  minProfit            Float?
  scanFrequencyMinutes Int           @default(60)
  isActive             Boolean       @default(true)
  scanLeaseToken       String?
  scanLeaseExpiresAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  monitoredProduct     MonitoredProduct?
  opportunities        Opportunity[]
  arbitrageOpportunities ArbitrageOpportunity[]
  scanJobs             ScanJob[]
  apiLogs              ApiLog[]

  @@index([isActive])
  @@index([scanLeaseExpiresAt])
  @@index([sourceMarketplace, destinationMarketplace])
  @@index([kind, isActive])
}

model MonitoredProduct {
  id                    Int          @id @default(autoincrement())
  userId                Int?
  savedSearchId         Int          @unique
  asin                  String
  amazonMarketplaceId   String
  title                 String
  brand                 String?
  model                 String?
  imageUrl              String?
  packageQuantity       Int?
  sourceKeywords        String
  targetBuyPrice        Float?
  notes                 String?
  lastAmazonPrice       Float?
  lastAmazonFeeEstimate Float?
  lastAmazonSyncAt      DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  savedSearch           SavedSearch  @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@unique([asin, amazonMarketplaceId])
  @@index([brand, updatedAt])
}

model MarketplaceListing {
  id                        Int                    @id @default(autoincrement())
  marketplace               Marketplace
  externalListingId         String
  listingKind               String                 @default("OFFER")
  title                     String
  subtitle                  String?
  condition                 String?
  buyingOptions             Json?
  currentPrice              Float
  shippingCost              Float?
  listingUrl                String
  imageUrl                  String?
  sellerName                String?
  sellerFeedbackPercentage  Float?
  sellerFeedbackScore       Int?
  gtin                      String?
  brand                     String?
  mpn                       String?
  upc                       String?
  categoryPath              String?
  locationCountry           String?
  quantityAvailable         Int?
  packageQuantity           Int?
  variant                   String?
  listingEndAt              DateTime?
  rawJson                   Json
  firstSeenAt               DateTime               @default(now())
  lastSeenAt                DateTime               @default(now())
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  snapshots                 ListingSnapshot[]
  sourceMatches             ListingMatch[]         @relation("SourceListingMatches")
  destinationMatches        ListingMatch[]         @relation("DestinationListingMatches")
  sourceOpportunities       ArbitrageOpportunity[] @relation("OpportunitySourceListing")
  destinationOpportunities  ArbitrageOpportunity[] @relation("OpportunityDestinationListing")

  @@unique([marketplace, externalListingId])
  @@index([marketplace, brand, currentPrice])
}

model ListingSnapshot {
  id                  Int               @id @default(autoincrement())
  marketplaceListingId Int
  observedAt          DateTime          @default(now())
  price               Float
  shippingCost        Float?
  quantityAvailable   Int?
  rawJson             Json?
  marketplaceListing  MarketplaceListing @relation(fields: [marketplaceListingId], references: [id], onDelete: Cascade)

  @@index([marketplaceListingId, observedAt])
}

model ListingMatch {
  id                   Int                    @id @default(autoincrement())
  sourceListingId      Int
  destinationListingId Int
  confidence           Int
  matchMethod          MatchMethod
  reasons              Json?
  warnings             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  sourceListing        MarketplaceListing     @relation("SourceListingMatches", fields: [sourceListingId], references: [id], onDelete: Cascade)
  destinationListing   MarketplaceListing     @relation("DestinationListingMatches", fields: [destinationListingId], references: [id], onDelete: Cascade)
  opportunities        ArbitrageOpportunity[]

  @@unique([sourceListingId, destinationListingId])
  @@index([confidence])
}

model ArbitrageOpportunity {
  id                        Int                                @id @default(autoincrement())
  opportunityKey            String                             @unique
  savedSearchId             Int
  sourceListingId           Int
  destinationListingId      Int?
  listingMatchId            Int?
  sourceItemCost            Float
  sourceShippingCost        Float
  sourceFeeEstimate         Float
  destinationSellPrice      Float
  destinationShippingCredit Float
  destinationFeeEstimate    Float
  fulfillmentCostEstimate   Float
  prepCostEstimate          Float
  labelCostEstimate         Float
  otherCostEstimate         Float
  totalCost                 Float
  netProfit                 Float
  roiPercent                Float
  marginPercent             Float
  breakEvenSellPrice        Float
  confidenceScore           Int
  riskScore                 Int
  riskFlags                 Json?
  status                    OpportunityStatus                  @default(NEW)
  notes                     String?
  lastScannedAt             DateTime
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  savedSearch               SavedSearch                         @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  sourceListing             MarketplaceListing                  @relation("OpportunitySourceListing", fields: [sourceListingId], references: [id], onDelete: Cascade)
  destinationListing        MarketplaceListing?                 @relation("OpportunityDestinationListing", fields: [destinationListingId], references: [id], onDelete: SetNull)
  listingMatch              ListingMatch?                       @relation(fields: [listingMatchId], references: [id], onDelete: SetNull)
  statusHistory             ArbitrageOpportunityStatusHistory[]
  snapshots                 ArbitrageOpportunitySnapshot[]

  @@index([savedSearchId, status])
  @@index([roiPercent])
  @@index([netProfit])
  @@index([confidenceScore])
}

model ArbitrageOpportunityStatusHistory {
  id             Int               @id @default(autoincrement())
  opportunityId  Int
  fromStatus     OpportunityStatus?
  toStatus       OpportunityStatus
  note           String?
  createdAt      DateTime          @default(now())
  opportunity    ArbitrageOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
}

model ArbitrageOpportunitySnapshot {
  id                     Int                 @id @default(autoincrement())
  opportunityId          Int
  observedAt             DateTime            @default(now())
  sourceItemCost         Float
  destinationSellPrice   Float
  destinationFeeEstimate Float
  netProfit              Float
  roiPercent             Float
  marginPercent          Float
  riskScore              Int
  calculationJson        Json?
  opportunity            ArbitrageOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, observedAt])
}

model ApiCacheEntry {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  payload   Json
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EbayListing {
  id                        Int           @id @default(autoincrement())
  ebayItemId                String        @unique
  title                     String
  subtitle                  String?
  condition                 String?
  buyingOptions             Json?
  currentPrice              Float
  shippingCost              Float?
  itemWebUrl                String
  imageUrl                  String?
  sellerUsername            String?
  sellerFeedbackPercentage  Float?
  sellerFeedbackScore       Int?
  gtin                      String?
  brand                     String?
  mpn                       String?
  upc                       String?
  categoryPath              String?
  locationCountry           String?
  listingEndAt              DateTime?
  rawJson                   Json
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  amazonMatch               AmazonMatch?
  opportunities             Opportunity[]
}

model AmazonMatch {
  id                 Int           @id @default(autoincrement())
  ebayListingId      Int           @unique
  asin               String?
  amazonTitle        String?
  brand              String?
  model              String?
  packageQuantity    Int?
  sizeColorVariant   String?
  imageUrl           String?
  amazonPrice        Float?
  featuredOfferPrice Float?
  feeEstimate        Float?
  fulfillmentFee     Float?
  referralFee        Float?
  matchConfidence    Int
  matchMethod        MatchMethod
  matchReasons       Json?
  matchWarnings      Json?
  rawCatalogJson     Json?
  rawPricingJson     Json?
  rawFeesJson        Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  ebayListing        EbayListing   @relation(fields: [ebayListingId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]
}

model Opportunity {
  id                  Int                        @id @default(autoincrement())
  savedSearchId       Int
  ebayListingId       Int
  amazonMatchId       Int?
  ebayItemCost        Float
  ebayShippingCost    Float
  inboundCostEstimate Float
  prepCostEstimate    Float
  labelCostEstimate   Float
  otherCostEstimate   Float
  totalLandedCost     Float
  amazonSellPrice     Float
  amazonFeeEstimate   Float
  netProfit           Float
  roiPercent          Float
  marginPercent       Float
  breakEvenSellPrice  Float
  riskScore           Int
  riskFlags           Json?
  status              OpportunityStatus         @default(NEW)
  notes               String?
  lastScannedAt       DateTime
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  savedSearch         SavedSearch               @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  ebayListing         EbayListing               @relation(fields: [ebayListingId], references: [id], onDelete: Cascade)
  amazonMatch         AmazonMatch?              @relation(fields: [amazonMatchId], references: [id], onDelete: SetNull)
  statusHistory       OpportunityStatusHistory[]

  @@unique([savedSearchId, ebayListingId])
  @@index([status])
  @@index([roiPercent])
  @@index([netProfit])
}

model OpportunityStatusHistory {
  id            Int               @id @default(autoincrement())
  opportunityId Int
  fromStatus    OpportunityStatus?
  toStatus      OpportunityStatus
  note          String?
  createdAt     DateTime          @default(now())
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
}

model ScanJob {
  id                   Int           @id @default(autoincrement())
  savedSearchId        Int
  status               ScanJobStatus @default(QUEUED)
  triggeredBy          String?
  startedAt            DateTime      @default(now())
  finishedAt           DateTime?
  itemCount            Int           @default(0)
  newOpportunityCount  Int           @default(0)
  warningCount         Int           @default(0)
  errorMessage         String?
  summaryJson          Json?
  savedSearch          SavedSearch   @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  apiLogs              ApiLog[]

  @@index([savedSearchId, startedAt])
}

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiLog {
  id           Int          @id @default(autoincrement())
  source       ApiLogSource
  operation    String
  requestKey   String?
  statusCode   Int?
  isSuccess    Boolean      @default(true)
  isThrottled  Boolean      @default(false)
  cacheHit     Boolean      @default(false)
  message      String?
  detail       Json?
  scanJobId    Int?
  savedSearchId Int?
  createdAt    DateTime     @default(now())
  scanJob      ScanJob?     @relation(fields: [scanJobId], references: [id], onDelete: SetNull)
  savedSearch  SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)

  @@index([source, createdAt])
  @@index([isThrottled])
}
