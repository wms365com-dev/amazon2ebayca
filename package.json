{
  "name": "ebay-canada-to-amazon-ca-fba-analyzer",
  "version": "1.0.0",
  "description": "Production-quality MVP for analyzing eBay Canada listings against Amazon.ca FBA opportunities.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "railway:start": "prisma migrate deploy && node dist/src/server.js",
    "scan:due": "tsx src/jobs/runDueScans.ts",
    "scan:due:build": "node dist/src/jobs/runDueScans.js",
    "railway:scan-due": "prisma migrate deploy && node dist/src/jobs/runDueScans.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "axios": "^1.9.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "node-cron": "^4.1.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.8.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
