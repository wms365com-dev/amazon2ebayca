<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="shell page-shell narrow">
  <section class="page-intro">
    <div>
      <h1>Settings</h1>
      <p>Keep connector credentials in Railway environment variables and tune the conservative defaults used for each marketplace direction.</p>
    </div>
  </section>

  <section class="status-grid">
    <article class="panel compact">
      <h2>eBay connector</h2>
      <p class="connector-status-row">
        <span class="badge <%= envStatus.ebayConfigured ? 'active-badge' : 'inactive-badge' %>"><%= envStatus.ebayConfigured ? 'Configured' : 'Missing' %></span>
        <span class="badge <%= connectorModes.ebay.badgeClass %>"><%= connectorModes.ebay.label %></span>
      </p>
      <p class="muted">Environment: <%= envStatus.ebayEnvironment %></p>
      <p class="muted"><%= connectorModes.ebay.reason %></p>
    </article>
    <article class="panel compact">
      <h2>Amazon connector</h2>
      <p class="connector-status-row">
        <span class="badge <%= envStatus.amazonConfigured ? 'active-badge' : 'inactive-badge' %>"><%= envStatus.amazonConfigured ? 'Configured' : 'Missing' %></span>
        <span class="badge <%= connectorModes.amazon.badgeClass %>"><%= connectorModes.amazon.label %></span>
      </p>
      <p class="muted">Amazon Canada marketplace is preloaded by default.</p>
      <p class="muted"><%= connectorModes.amazon.reason %></p>
    </article>
  </section>

  <section class="panel">
    <form method="post" action="/settings" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label>
        <span>Amazon marketplace ID</span>
        <input type="text" name="amazonMarketplaceId" value="<%= settings.amazonMarketplaceId %>" />
      </label>

      <label>
        <span>Default Amazon inbound cost</span>
        <input type="number" step="0.01" name="defaultInboundCost" value="<%= settings.defaultInboundCost %>" />
      </label>

      <label>
        <span>Default prep cost</span>
        <input type="number" step="0.01" name="defaultPrepCost" value="<%= settings.defaultPrepCost %>" />
      </label>

      <label>
        <span>Default label cost</span>
        <input type="number" step="0.01" name="defaultLabelCost" value="<%= settings.defaultLabelCost %>" />
      </label>

      <label>
        <span>Default other cost</span>
        <input type="number" step="0.01" name="defaultOtherCost" value="<%= settings.defaultOtherCost %>" />
      </label>

      <label>
        <span>Default outbound shipping cost</span>
        <input type="number" step="0.01" name="defaultOutboundShippingCost" value="<%= settings.defaultOutboundShippingCost %>" />
      </label>

      <label>
        <span>Default eBay final value fee rate</span>
        <input type="number" step="0.01" min="0" max="1" name="defaultEbayFinalValueFeePercent" value="<%= settings.defaultEbayFinalValueFeePercent %>" />
      </label>

      <label>
        <span>Default eBay fixed fee</span>
        <input type="number" step="0.01" min="0" name="defaultEbayFixedFee" value="<%= settings.defaultEbayFixedFee %>" />
      </label>

      <label>
        <span>Sales tax rate</span>
        <input type="number" step="0.01" min="0" max="1" name="salesTaxRate" value="<%= settings.salesTaxRate %>" />
      </label>

      <label class="toggle">
        <input type="checkbox" name="applySalesTax" <%= settings.applySalesTax ? 'checked' : '' %> />
        <span>Apply sales tax assumptions</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="schedulerEnabled" <%= settings.schedulerEnabled ? 'checked' : '' %> />
        <span>Enable background scanning</span>
      </label>

      <label>
        <span>Scheduler minimum interval (minutes)</span>
        <input type="number" min="5" max="1440" name="schedulerMinIntervalMinutes" value="<%= settings.schedulerMinIntervalMinutes %>" />
      </label>

      <label class="toggle">
        <input type="checkbox" name="rateLimitSafeMode" <%= settings.rateLimitSafeMode ? 'checked' : '' %> />
        <span>Rate-limit safe mode</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="demoModeOverride" <%= settings.demoModeOverride ? 'checked' : '' %> />
        <span>Force all connectors into demo mode</span>
      </label>

      <div class="panel compact span-two">
        <h3>Connector fallback behavior</h3>
        <p class="muted">
          <code>DEMO_MODE=true</code> now acts as connector fallback. If eBay credentials exist but Amazon credentials do not,
          the app runs live eBay data with Amazon demo fixtures until SP-API credentials are added. Use the toggle above only
          when you want to force every connector into demo mode.
        </p>
      </div>

      <label>
        <span>Minimum confidence for clean opportunities</span>
        <input type="number" min="0" max="100" name="opportunityMinConfidence" value="<%= settings.opportunityMinConfidence %>" />
      </label>

      <label>
        <span>Maximum risk for clean opportunities</span>
        <input type="number" min="0" max="100" name="opportunityMaxRisk" value="<%= settings.opportunityMaxRisk %>" />
      </label>

      <label class="toggle span-two">
        <input type="checkbox" name="requireImageVerification" <%= settings.requireImageVerification ? 'checked' : '' %> />
        <span>Require source and destination images before surfacing an item as a clean deal</span>
      </label>

      <label class="span-two">
        <span>IP complaint alert brands</span>
        <textarea name="ipComplaintBrands" rows="5" placeholder="Nike&#10;LEGO&#10;OtterBox"><%= settings.ipComplaintBrands.join('\n') %></textarea>
        <small class="muted">Paste brands you avoid because of Amazon complaints, eBay VeRO profiles, or prior legal/IP issues. Matching items stay stored in the database and get routed to review with an alert.</small>
      </label>

      <div class="form-actions">
        <button type="submit" class="button">Save settings</button>
      </div>
    </form>
  </section>
</main>

<%- include("../partials/footer") %>
