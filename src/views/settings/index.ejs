<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="shell page-shell narrow">
  <section class="page-intro">
    <div>
      <h1>Settings</h1>
      <p>Secrets stay in environment variables. This page manages marketplace defaults, conservative cost assumptions, and scheduler behavior.</p>
    </div>
  </section>

  <section class="status-grid">
    <article class="panel compact">
      <h2>eBay credentials</h2>
      <p><span class="badge <%= envStatus.ebayConfigured ? 'active-badge' : 'inactive-badge' %>"><%= envStatus.ebayConfigured ? 'Configured' : 'Missing' %></span></p>
      <p class="muted">Environment: <%= envStatus.ebayEnvironment %></p>
    </article>
    <article class="panel compact">
      <h2>Amazon SP-API</h2>
      <p><span class="badge <%= envStatus.amazonConfigured ? 'active-badge' : 'inactive-badge' %>"><%= envStatus.amazonConfigured ? 'Configured' : 'Missing' %></span></p>
      <p class="muted">Canada marketplace default is preloaded.</p>
    </article>
  </section>

  <section class="panel">
    <form method="post" action="/settings" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label>
        <span>Amazon marketplace ID</span>
        <input type="text" name="amazonMarketplaceId" value="<%= settings.amazonMarketplaceId %>" />
      </label>

      <label>
        <span>Default inbound cost</span>
        <input type="number" step="0.01" name="defaultInboundCost" value="<%= settings.defaultInboundCost %>" />
      </label>

      <label>
        <span>Default prep cost</span>
        <input type="number" step="0.01" name="defaultPrepCost" value="<%= settings.defaultPrepCost %>" />
      </label>

      <label>
        <span>Default label cost</span>
        <input type="number" step="0.01" name="defaultLabelCost" value="<%= settings.defaultLabelCost %>" />
      </label>

      <label>
        <span>Default other cost</span>
        <input type="number" step="0.01" name="defaultOtherCost" value="<%= settings.defaultOtherCost %>" />
      </label>

      <label>
        <span>Sales tax rate</span>
        <input type="number" step="0.01" min="0" max="1" name="salesTaxRate" value="<%= settings.salesTaxRate %>" />
      </label>

      <label class="toggle">
        <input type="checkbox" name="applySalesTax" <%= settings.applySalesTax ? 'checked' : '' %> />
        <span>Apply sales tax assumptions</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="schedulerEnabled" <%= settings.schedulerEnabled ? 'checked' : '' %> />
        <span>Enable scheduler</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="rateLimitSafeMode" <%= settings.rateLimitSafeMode ? 'checked' : '' %> />
        <span>Rate-limit safe mode</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="demoModeOverride" <%= settings.demoModeOverride ? 'checked' : '' %> />
        <span>Force demo mode</span>
      </label>

      <div class="form-actions">
        <button type="submit" class="button">Save settings</button>
      </div>
    </form>
  </section>
</main>

<%- include("../partials/footer") %>
