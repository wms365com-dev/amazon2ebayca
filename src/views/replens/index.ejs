<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="shell page-shell">
  <section class="page-intro">
    <div>
      <h1>Replen Monitor</h1>
      <p>Import ASINs from your Amazon catalog, set target buy prices, and let the app monitor eBay for profitable replenishment opportunities.</p>
    </div>
  </section>

  <section class="metric-grid">
    <article class="metric-card">
      <span class="metric-label">Tracked replens</span>
      <strong><%= metrics.totalProducts %></strong>
    </article>
    <article class="metric-card">
      <span class="metric-label">Active replens</span>
      <strong><%= metrics.activeProducts %></strong>
    </article>
    <article class="metric-card">
      <span class="metric-label">Profitable replen hits</span>
      <strong><%= metrics.profitableOpportunities %></strong>
    </article>
  </section>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>Bulk Import ASINs</h2>
        <p class="muted">Paste one or more ASINs to create exact-match monitoring profiles. The importer reuses your existing items if they already exist.</p>
      </div>
    </div>
    <form method="post" action="/replens/import" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label class="span-two">
        <span>ASINs</span>
        <textarea name="asinsText" rows="7" placeholder="B08N5WRWNW&#10;B0B8Q9P6Z4&#10;B07FZ8S74R" required></textarea>
      </label>

      <label>
        <span>Target buy price</span>
        <input type="number" step="0.01" name="targetBuyPrice" value="<%= importDefaults.targetBuyPrice %>" />
      </label>

      <label>
        <span>Max shipping cost</span>
        <input type="number" step="0.01" name="maxShipping" value="<%= importDefaults.maxShipping %>" />
      </label>

      <label>
        <span>Min ROI %</span>
        <input type="number" step="0.01" name="minROI" value="<%= importDefaults.minROI %>" />
      </label>

      <label>
        <span>Min profit</span>
        <input type="number" step="0.01" name="minProfit" value="<%= importDefaults.minProfit %>" />
      </label>

      <label>
        <span>Scan frequency (minutes)</span>
        <input type="number" min="5" max="1440" name="scanFrequencyMinutes" value="<%= importDefaults.scanFrequencyMinutes %>" />
      </label>

      <label class="toggle">
        <input type="checkbox" name="isActive" <%= importDefaults.isActive ? 'checked' : '' %> />
        <span>Start active</span>
      </label>

      <label class="span-two">
        <span>Notes</span>
        <textarea name="notes" rows="3" placeholder="Optional sourcing note or list name"><%= importDefaults.notes %></textarea>
      </label>

      <div class="form-actions">
        <button type="submit" class="button">Import replens</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Item</th>
            <th>ASIN</th>
            <th>Target</th>
            <th>Amazon</th>
            <th>Monitoring</th>
            <th>Last scan</th>
            <th>Best hit</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (monitoredProducts.length === 0) { %>
            <tr><td colspan="8" class="empty">No monitored replens yet. Import ASINs above to start tracking your winners.</td></tr>
          <% } %>
          <% monitoredProducts.forEach((item) => { const bestHit = item.savedSearch.arbitrageOpportunities[0]; const latestScan = item.savedSearch.scanJobs[0]; %>
            <tr>
              <td>
                <div class="replen-item">
                  <% if (item.imageUrl) { %>
                    <img src="<%= item.imageUrl %>" alt="Amazon item" class="thumb" />
                  <% } else { %>
                    <div class="thumb placeholder"></div>
                  <% } %>
                  <div>
                    <strong><%= item.title %></strong>
                    <div class="muted"><%= item.brand ?? 'Unknown brand' %></div>
                    <div class="muted"><span class="badge <%= item.savedSearch.isActive ? 'active-badge' : 'inactive-badge' %>"><%= item.savedSearch.isActive ? 'Active' : 'Paused' %></span></div>
                  </div>
                </div>
              </td>
              <td>
                <div><code><%= item.asin %></code></div>
                <div class="muted"><a href="https://www.amazon.ca/dp/<%= item.asin %>" target="_blank" rel="noreferrer" class="text-link">Open Amazon</a></div>
              </td>
              <td>
                <div><%= item.targetBuyPrice !== null ? formatCurrency(item.targetBuyPrice) : 'Not set' %></div>
                <div class="muted">Max shipping <%= item.savedSearch.maxShipping !== null ? formatCurrency(item.savedSearch.maxShipping) : '--' %></div>
              </td>
              <td>
                <div><%= item.lastAmazonPrice !== null ? formatCurrency(item.lastAmazonPrice) : '--' %></div>
                <div class="muted">Fees <%= item.lastAmazonFeeEstimate !== null ? formatCurrency(item.lastAmazonFeeEstimate) : '--' %></div>
              </td>
              <td>
                <div class="muted">Keywords: <%= item.sourceKeywords %></div>
                <div class="muted">ROI >= <%= item.savedSearch.minROI ?? '--' %> | Profit >= <%= item.savedSearch.minProfit !== null ? formatCurrency(item.savedSearch.minProfit) : '--' %></div>
                <div class="muted">Every <%= item.savedSearch.scanFrequencyMinutes %> min</div>
              </td>
              <td><%= latestScan ? formatDateTime(latestScan.startedAt) : 'Never' %></td>
              <td>
                <% if (bestHit) { %>
                  <div class="profit <%= bestHit.netProfit >= 0 ? 'positive' : 'negative' %>"><%= formatCurrency(bestHit.netProfit) %></div>
                  <div class="muted"><%= bestHit.roiPercent.toFixed(1) %>% ROI</div>
                  <div class="muted"><a href="/opportunities/<%= bestHit.id %>" class="text-link">Open best hit</a></div>
                <% } else { %>
                  <span class="muted">No profitable hit yet</span>
                <% } %>
              </td>
              <td>
                <div class="action-stack">
                  <form method="post" action="/replens/<%= item.id %>/scan">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="button small">Scan now</button>
                  </form>
                  <a href="/replens/<%= item.id %>/edit" class="button secondary small">Edit</a>
                  <a href="/opportunities?sourceSearchId=<%= item.savedSearchId %>" class="text-link">View hits</a>
                  <form method="post" action="/replens/<%= item.id %>/toggle">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="button ghost small"><%= item.savedSearch.isActive ? 'Pause' : 'Resume' %></button>
                  </form>
                  <form method="post" action="/replens/<%= item.id %>/delete" data-confirm="Delete this monitored replen item?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="button ghost small">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
