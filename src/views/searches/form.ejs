<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="shell page-shell narrow">
  <section class="page-intro">
    <div>
      <h1><%= formMode === 'create' ? 'Create Scan Profile' : 'Edit Scan Profile' %></h1>
      <p>Set the source marketplace you want to buy from and the destination marketplace you want to resell on. The app keeps each scan's data in the database for history and re-ranking.</p>
    </div>
  </section>

  <% if (formMode === 'create') { %>
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2>Suggested Templates</h2>
          <p class="muted">Use a starting pattern for best sellers, replenishable products, or faster-moving branded items.</p>
        </div>
      </div>
      <% if (selectedTemplate) { %>
        <div class="template-highlight">
          <span class="badge active-badge">Template loaded</span>
          <strong><%= selectedTemplate.draft.name %></strong>
          <p class="muted"><%= selectedTemplate.summary %></p>
        </div>
      <% } %>
      <div class="template-grid">
        <% suggestedTemplates.forEach((template) => { %>
          <article class="template-card <%= selectedTemplate?.slug === template.slug ? 'template-card-selected' : '' %>">
            <div class="template-topline">
              <span class="badge"><%= template.strategy %></span>
              <span class="badge"><%= template.draft.sourceMarketplace %> -> <%= template.draft.destinationMarketplace %></span>
            </div>
            <h3><%= template.draft.name %></h3>
            <p><%= template.summary %></p>
            <p class="muted"><strong>Why this works:</strong> <%= template.rationale %></p>
            <div class="tag-list">
              <% template.watchouts.forEach((item) => { %>
                <span class="tag warning"><%= item %></span>
              <% }) %>
            </div>
            <div class="template-actions">
              <a href="/searches/new?template=<%= template.slug %>" class="button secondary small">
                <%= selectedTemplate?.slug === template.slug ? 'Loaded' : 'Load template' %>
              </a>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="panel">
    <form method="post" action="<%= formMode === 'create' ? '/searches' : `/searches/${search.id}/update` %>" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label>
        <span>Profile name</span>
        <input type="text" name="name" required value="<%= search?.name ?? '' %>" />
      </label>

      <label>
        <span>Source marketplace</span>
        <select name="sourceMarketplace">
          <% marketplaces.forEach((marketplace) => { %>
            <option value="<%= marketplace %>" <%= (search?.sourceMarketplace ?? 'EBAY_CA') === marketplace ? 'selected' : '' %>><%= marketplace %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Destination marketplace</span>
        <select name="destinationMarketplace">
          <% marketplaces.forEach((marketplace) => { %>
            <option value="<%= marketplace %>" <%= (search?.destinationMarketplace ?? 'AMAZON_CA') === marketplace ? 'selected' : '' %>><%= marketplace %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Keywords</span>
        <input type="text" name="keywords" required value="<%= search?.keywords ?? '' %>" />
      </label>

      <label>
        <span>Category ID</span>
        <input type="text" name="categoryId" value="<%= search?.categoryId ?? '' %>" />
      </label>

      <label>
        <span>Condition filter</span>
        <input type="text" name="conditionFilter" placeholder="NEW" value="<%= search?.conditionFilter ?? '' %>" />
      </label>

      <label>
        <span>Include brands</span>
        <input type="text" name="includeBrands" value="<%= Array.isArray(search?.includeBrands) ? search.includeBrands.join(', ') : '' %>" />
      </label>

      <label>
        <span>Exclude brands</span>
        <input type="text" name="excludeBrands" value="<%= Array.isArray(search?.excludeBrands) ? search.excludeBrands.join(', ') : '' %>" />
      </label>

      <label>
        <span>Min source price</span>
        <input type="number" step="0.01" name="minPrice" value="<%= search?.minPrice ?? '' %>" />
      </label>

      <label>
        <span>Max source price</span>
        <input type="number" step="0.01" name="maxPrice" value="<%= search?.maxPrice ?? '' %>" />
      </label>

      <label>
        <span>Max source shipping cost</span>
        <input type="number" step="0.01" name="maxShipping" value="<%= search?.maxShipping ?? '' %>" />
      </label>

      <label>
        <span>Minimum ROI %</span>
        <input type="number" step="0.01" name="minROI" value="<%= search?.minROI ?? '' %>" />
      </label>

      <label>
        <span>Minimum net profit</span>
        <input type="number" step="0.01" name="minProfit" value="<%= search?.minProfit ?? '' %>" />
      </label>

      <label>
        <span>Scan frequency (minutes)</span>
        <input type="number" min="5" max="1440" name="scanFrequencyMinutes" value="<%= search?.scanFrequencyMinutes ?? 60 %>" />
      </label>

      <label class="toggle">
        <input type="checkbox" name="buyItNowOnly" <%= (search?.buyItNowOnly ?? true) ? 'checked' : '' %> />
        <span>Buy it now only</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="allowAuctions" <%= search?.allowAuctions ? 'checked' : '' %> />
        <span>Allow auctions</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="isActive" <%= (search?.isActive ?? true) ? 'checked' : '' %> />
        <span>Active profile</span>
      </label>

      <div class="form-actions">
        <button type="submit" class="button"><%= formMode === 'create' ? 'Create profile' : 'Save changes' %></button>
        <a href="/searches" class="button secondary">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include("../partials/footer") %>
