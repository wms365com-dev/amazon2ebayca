<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="shell page-shell narrow">
  <section class="page-intro">
    <div>
      <h1><%= formMode === 'create' ? 'Create Saved Search' : 'Edit Saved Search' %></h1>
      <p>Focus on the cleanest signals first: exact brand terms, realistic shipping caps, and conservative ROI thresholds.</p>
    </div>
  </section>

  <section class="panel">
    <form method="post" action="<%= formMode === 'create' ? '/searches' : `/searches/${search.id}/update` %>" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label>
        <span>Search name</span>
        <input type="text" name="name" required value="<%= search?.name ?? '' %>" />
      </label>

      <label>
        <span>Keywords</span>
        <input type="text" name="keywords" required value="<%= search?.keywords ?? '' %>" />
      </label>

      <label>
        <span>Category ID</span>
        <input type="text" name="categoryId" value="<%= search?.categoryId ?? '' %>" />
      </label>

      <label>
        <span>Condition filter</span>
        <input type="text" name="conditionFilter" placeholder="NEW" value="<%= search?.conditionFilter ?? '' %>" />
      </label>

      <label>
        <span>Include brands</span>
        <input type="text" name="includeBrands" value="<%= Array.isArray(search?.includeBrands) ? search.includeBrands.join(', ') : '' %>" />
      </label>

      <label>
        <span>Exclude brands</span>
        <input type="text" name="excludeBrands" value="<%= Array.isArray(search?.excludeBrands) ? search.excludeBrands.join(', ') : '' %>" />
      </label>

      <label>
        <span>Min eBay price</span>
        <input type="number" step="0.01" name="minPrice" value="<%= search?.minPrice ?? '' %>" />
      </label>

      <label>
        <span>Max eBay price</span>
        <input type="number" step="0.01" name="maxPrice" value="<%= search?.maxPrice ?? '' %>" />
      </label>

      <label>
        <span>Max shipping cost</span>
        <input type="number" step="0.01" name="maxShipping" value="<%= search?.maxShipping ?? '' %>" />
      </label>

      <label>
        <span>Minimum ROI %</span>
        <input type="number" step="0.01" name="minROI" value="<%= search?.minROI ?? '' %>" />
      </label>

      <label>
        <span>Minimum net profit</span>
        <input type="number" step="0.01" name="minProfit" value="<%= search?.minProfit ?? '' %>" />
      </label>

      <label>
        <span>Scan frequency (minutes)</span>
        <input type="number" min="5" max="1440" name="scanFrequencyMinutes" value="<%= search?.scanFrequencyMinutes ?? 60 %>" />
      </label>

      <label class="toggle">
        <input type="checkbox" name="buyItNowOnly" <%= (search?.buyItNowOnly ?? true) ? 'checked' : '' %> />
        <span>Buy it now only</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="allowAuctions" <%= search?.allowAuctions ? 'checked' : '' %> />
        <span>Allow auctions</span>
      </label>

      <label class="toggle">
        <input type="checkbox" name="isActive" <%= (search?.isActive ?? true) ? 'checked' : '' %> />
        <span>Active search</span>
      </label>

      <div class="form-actions">
        <button type="submit" class="button"><%= formMode === 'create' ? 'Create search' : 'Save changes' %></button>
        <a href="/searches" class="button secondary">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include("../partials/footer") %>
