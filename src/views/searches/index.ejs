<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="shell page-shell">
  <section class="page-intro">
    <div>
      <h1>Scan Profiles</h1>
      <p>Define source and destination marketplaces, keep every observation in the database, and rescan them on demand or on schedule.</p>
    </div>
    <div class="intro-actions">
      <a href="/searches/new" class="button">Create profile</a>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>Suggested Search Ideas</h2>
        <p class="muted">Start with proven product patterns like best sellers, replenishable consumables, and faster-moving branded accessories.</p>
      </div>
      <a href="/searches/new" class="text-link">Build from scratch</a>
    </div>
    <div class="template-grid">
      <% suggestedTemplates.forEach((template) => { %>
        <article class="template-card">
          <div class="template-topline">
            <span class="badge"><%= template.strategy %></span>
            <span class="badge"><%= template.draft.sourceMarketplace %> -> <%= template.draft.destinationMarketplace %></span>
          </div>
          <h3><%= template.draft.name %></h3>
          <p><%= template.summary %></p>
          <p class="muted"><strong>Why this works:</strong> <%= template.rationale %></p>
          <div class="tag-list">
            <% template.watchouts.forEach((item) => { %>
              <span class="tag warning"><%= item %></span>
            <% }) %>
          </div>
          <div class="template-metrics muted">
            Keywords: <%= template.draft.keywords %>
          </div>
          <div class="template-actions">
            <a href="/searches/new?template=<%= template.slug %>" class="button secondary small">Use template</a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="panel">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Direction</th>
            <th>Keywords</th>
            <th>Filters</th>
            <th>Last scan</th>
            <th>Opportunities</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (savedSearches.length === 0) { %>
            <tr><td colspan="7" class="empty">No scan profiles yet.</td></tr>
          <% } %>
          <% savedSearches.forEach((search) => { %>
            <tr>
              <td>
                <strong><%= search.name %></strong>
                <div class="muted"><span class="badge <%= search.isActive ? 'active-badge' : 'inactive-badge' %>"><%= search.isActive ? 'Active' : 'Inactive' %></span></div>
              </td>
              <td><span class="badge"><%= search.sourceMarketplace %> -> <%= search.destinationMarketplace %></span></td>
              <td><%= search.keywords %></td>
              <td>
                <div class="muted">ROI >= <%= search.minROI ?? '--' %> | Profit >= <%= formatCurrency(search.minProfit) %></div>
                <div class="muted">Every <%= search.scanFrequencyMinutes %> min</div>
              </td>
              <td><%= search.scanJobs[0] ? formatDateTime(search.scanJobs[0].startedAt) : 'Never' %></td>
              <td><%= search._count.arbitrageOpportunities %></td>
              <td>
                <div class="action-row">
                  <form method="post" action="/searches/<%= search.id %>/scan">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="button small">Scan now</button>
                  </form>
                  <a href="/searches/<%= search.id %>/edit" class="button secondary small">Edit</a>
                  <form method="post" action="/searches/<%= search.id %>/delete" data-confirm="Delete this scan profile?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="button ghost small">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
