<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<% const sourceIdentifier = getListingIdentifier(opportunity.sourceListing); %>
<% const destinationIdentifier = opportunity.destinationListing ? getListingIdentifier(opportunity.destinationListing) : null; %>
<% const sourceIsDemo = isDemoFixtureRecord(opportunity.sourceListing.rawJson); %>
<% const destinationIsDemo = opportunity.destinationListing ? isDemoFixtureRecord(opportunity.destinationListing.rawJson) : false; %>
<% const usesAnyDemoData = sourceIsDemo || destinationIsDemo; %>

<main class="shell page-shell">
  <section class="page-intro">
    <div>
      <h1>Opportunity Detail</h1>
      <p>Review the source listing, destination evidence, identifiers, and workflow notes before making a sourcing decision.</p>
    </div>
    <div class="intro-actions">
      <a href="/opportunities" class="button secondary">Back to list</a>
    </div>
  </section>

  <% if (usesAnyDemoData) { %>
    <section class="panel notice-panel">
      <strong>This opportunity contains demo fixture data.</strong>
      <p class="muted">At least one side of this comparison is simulated. The prices, images, and match evidence are useful for UI testing only and should not be used to buy inventory.</p>
    </section>
  <% } %>

  <section class="detail-grid">
    <article class="panel">
      <div class="panel-head">
        <h2>Source listing</h2>
        <a href="<%= opportunity.sourceListing.listingUrl %>" target="_blank" rel="noreferrer" class="text-link">Open source listing</a>
      </div>
      <div class="detail-card">
        <img src="<%= resolveListingDisplayImage(opportunity.sourceListing) %>" alt="Source item image" class="detail-image" />
        <div class="detail-copy">
          <strong><%= opportunity.sourceListing.title %></strong>
          <p class="muted">Marketplace: <%= opportunity.sourceListing.marketplace %></p>
          <p class="muted">Condition: <%= opportunity.sourceListing.condition ?? 'Unknown' %></p>
          <p class="muted">Brand: <%= opportunity.sourceListing.brand ?? 'Unknown' %> | <%= sourceIdentifier.label %>: <%= sourceIdentifier.value %></p>
          <% if (opportunity.sourceListing.sellerName) { %>
            <p class="muted">Seller: <%= opportunity.sourceListing.sellerName %> | Feedback: <%= opportunity.sourceListing.sellerFeedbackPercentage ?? '--' %>%</p>
          <% } %>
          <div class="tag-list compact-tags">
            <span class="tag <%= sourceIsDemo ? 'warning' : 'success' %>"><%= getListingDataSourceLabel(opportunity.sourceListing.rawJson) %></span>
            <span class="tag"><%= getListingVisualStatus(opportunity.sourceListing) %></span>
          </div>
        </div>
      </div>
    </article>

    <article class="panel">
      <div class="panel-head">
        <h2>Destination listing</h2>
        <% if (opportunity.destinationListing?.listingUrl) { %>
          <a href="<%= opportunity.destinationListing.listingUrl %>" target="_blank" rel="noreferrer" class="text-link">Open destination listing</a>
        <% } %>
      </div>
      <% if (opportunity.destinationListing) { %>
        <div class="detail-card">
          <img src="<%= resolveListingDisplayImage(opportunity.destinationListing) %>" alt="Destination item image" class="detail-image" />
          <div class="detail-copy">
            <strong><%= opportunity.destinationListing.title %></strong>
            <p class="muted">Marketplace: <%= opportunity.destinationListing.marketplace %></p>
            <p class="muted"><%= destinationIdentifier?.label ?? 'ID' %>: <%= destinationIdentifier?.value ?? '--' %></p>
            <p class="muted">Confidence: <span class="badge confidence"><%= opportunity.confidenceScore %></span></p>
            <% if (opportunity.listingMatch) { %>
              <p class="muted">Method: <%= opportunity.listingMatch.matchMethod %></p>
            <% } %>
            <div class="tag-list compact-tags">
              <span class="tag <%= destinationIsDemo ? 'warning' : 'success' %>"><%= getListingDataSourceLabel(opportunity.destinationListing.rawJson) %></span>
              <span class="tag"><%= getListingVisualStatus(opportunity.destinationListing) %></span>
            </div>
          </div>
        </div>
        <div class="tag-list">
          <% (Array.isArray(opportunity.listingMatch?.reasons) ? opportunity.listingMatch.reasons : []).forEach((reason) => { %>
            <span class="tag success"><%= reason %></span>
          <% }) %>
          <% (Array.isArray(opportunity.listingMatch?.warnings) ? opportunity.listingMatch.warnings : []).forEach((warning) => { %>
            <span class="tag warning"><%= warning %></span>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty">No confident destination listing was stored yet.</p>
      <% } %>
    </article>
  </section>

  <section class="detail-grid">
    <article class="panel">
      <h2>Pricing breakdown</h2>
      <dl class="stats-list">
        <div><dt>Direction</dt><dd><%= opportunity.savedSearch.sourceMarketplace %> -> <%= opportunity.savedSearch.destinationMarketplace %></dd></div>
        <div><dt>Source item cost</dt><dd><%= formatCurrency(opportunity.sourceItemCost) %></dd></div>
        <div><dt>Source shipping</dt><dd><%= formatCurrency(opportunity.sourceShippingCost) %></dd></div>
        <div><dt>Source fees</dt><dd><%= formatCurrency(opportunity.sourceFeeEstimate) %></dd></div>
        <div><dt>Destination expected revenue</dt><dd><%= formatCurrency(opportunity.destinationSellPrice) %></dd></div>
        <div><dt>Recovered shipping credit</dt><dd><%= formatCurrency(opportunity.destinationShippingCredit) %></dd></div>
        <div><dt>Destination fees</dt><dd><%= formatCurrency(opportunity.destinationFeeEstimate) %></dd></div>
        <div><dt>Fulfillment cost</dt><dd><%= formatCurrency(opportunity.fulfillmentCostEstimate) %></dd></div>
        <div><dt>Prep cost</dt><dd><%= formatCurrency(opportunity.prepCostEstimate) %></dd></div>
        <div><dt>Label cost</dt><dd><%= formatCurrency(opportunity.labelCostEstimate) %></dd></div>
        <div><dt>Other costs</dt><dd><%= formatCurrency(opportunity.otherCostEstimate) %></dd></div>
        <div><dt>Total cost</dt><dd><%= formatCurrency(opportunity.totalCost) %></dd></div>
        <div><dt>Net profit</dt><dd class="<%= opportunity.netProfit >= 0 ? 'positive' : 'negative' %>"><%= formatCurrency(opportunity.netProfit) %></dd></div>
        <div><dt>ROI</dt><dd><%= opportunity.roiPercent.toFixed(1) %>%</dd></div>
        <div><dt>Margin</dt><dd><%= opportunity.marginPercent.toFixed(1) %>%</dd></div>
        <div><dt>Break-even</dt><dd><%= formatCurrency(opportunity.breakEvenSellPrice) %></dd></div>
      </dl>
    </article>

    <article class="panel">
      <h2>Evidence summary</h2>
      <dl class="stats-list">
        <div><dt>Source data</dt><dd><%= getListingDataSourceLabel(opportunity.sourceListing.rawJson) %></dd></div>
        <div><dt>Destination data</dt><dd><%= opportunity.destinationListing ? getListingDataSourceLabel(opportunity.destinationListing.rawJson) : 'No destination saved' %></dd></div>
        <div><dt>Source identifier</dt><dd><%= sourceIdentifier.label %> <%= sourceIdentifier.value %></dd></div>
        <div><dt>Destination identifier</dt><dd><%= destinationIdentifier ? `${destinationIdentifier.label} ${destinationIdentifier.value}` : '--' %></dd></div>
        <div><dt>Source image</dt><dd><%= getListingVisualStatus(opportunity.sourceListing) %></dd></div>
        <div><dt>Destination image</dt><dd><%= opportunity.destinationListing ? getListingVisualStatus(opportunity.destinationListing) : 'No destination saved' %></dd></div>
      </dl>
    </article>

    <article class="panel">
      <h2>Assumptions and risk</h2>
      <p class="muted">Amazon marketplace ID: <%= settings.amazonMarketplaceId %></p>
      <p class="muted">Sales tax assumption: <%= settings.applySalesTax ? `On (${(settings.salesTaxRate * 100).toFixed(0)}%)` : 'Off' %></p>
      <p class="muted">Current status: <span class="badge status-<%= opportunity.status.toLowerCase() %>"><%= opportunity.status %></span></p>
      <p class="muted">Risk score: <span class="badge risk risk-<%= opportunity.riskScore >= 70 ? 'high' : opportunity.riskScore >= 40 ? 'medium' : 'low' %>"><%= opportunity.riskScore %></span></p>
      <div class="tag-list">
        <% (Array.isArray(opportunity.riskFlags) ? opportunity.riskFlags : []).forEach((flag) => { %>
          <span class="tag danger"><%= flag.code %> - <%= flag.message %></span>
        <% }) %>
      </div>
      <% if ((Array.isArray(opportunity.riskFlags) ? opportunity.riskFlags : []).length === 0) { %>
        <p class="empty">No risk flags were triggered for this opportunity.</p>
      <% } %>
    </article>
  </section>

  <section class="detail-grid">
    <article class="panel">
      <h2>Workflow</h2>
      <form method="post" action="/opportunities/<%= opportunity.id %>/status" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          <span>Status</span>
          <select name="status">
            <% statuses.forEach((status) => { %>
              <option value="<%= status %>" <%= opportunity.status === status ? 'selected' : '' %>><%= status %></option>
            <% }) %>
          </select>
        </label>
        <label class="grow">
          <span>History note</span>
          <input type="text" name="note" placeholder="Optional note" />
        </label>
        <button type="submit" class="button">Update status</button>
      </form>

      <form method="post" action="/opportunities/<%= opportunity.id %>/rescan" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="button secondary">Rescan now</button>
      </form>

      <h3>Notes</h3>
      <form method="post" action="/opportunities/<%= opportunity.id %>/notes" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <textarea name="notes" rows="6" placeholder="Add sourcing notes, buyer questions, or listing improvement ideas."><%= opportunity.notes ?? '' %></textarea>
        <button type="submit" class="button">Save notes</button>
      </form>
    </article>

    <article class="panel">
      <h2>Status history</h2>
      <div class="timeline">
        <% if (opportunity.statusHistory.length === 0) { %>
          <p class="empty">No history yet.</p>
        <% } %>
        <% opportunity.statusHistory.forEach((entry) => { %>
          <div class="timeline-item">
            <strong><%= entry.fromStatus ?? 'Created' %> -> <%= entry.toStatus %></strong>
            <div class="muted"><%= formatDateTime(entry.createdAt) %></div>
            <% if (entry.note) { %><div><%= entry.note %></div><% } %>
          </div>
        <% }) %>
      </div>

      <h3>Recent pricing history</h3>
      <div class="timeline">
        <% opportunity.snapshots.forEach((snapshot) => { %>
          <div class="timeline-item">
            <strong><%= formatCurrency(snapshot.netProfit) %> profit</strong>
            <div class="muted"><%= formatDateTime(snapshot.observedAt) %></div>
            <div>ROI <%= snapshot.roiPercent.toFixed(1) %>% | Risk <%= snapshot.riskScore %></div>
          </div>
        <% }) %>
      </div>

      <h3>Recent rescans</h3>
      <div class="timeline">
        <% rescans.forEach((job) => { %>
          <div class="timeline-item">
            <strong><%= job.status %></strong>
            <div class="muted"><%= formatDateTime(job.startedAt) %></div>
            <% if (job.errorMessage) { %><div><%= job.errorMessage %></div><% } %>
          </div>
        <% }) %>
      </div>
    </article>
  </section>
</main>

<%- include("../partials/footer") %>
